<Window x:Class="StreamOrchestra.App.Views.AddRecordingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="방송 추가"
        Width="620"
        Height="610"
        MinWidth="560"
        MinHeight="570"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0E1724"
        Foreground="#F5F7FB"
        FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#91A0B3" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F7FB" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#121F2E" />
            <Setter Property="Foreground" Value="#F5F7FB" />
            <Setter Property="BorderBrush" Value="#324257" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#F5F7FB" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#121F2E" />
            <Setter Property="Foreground" Value="#F5F7FB" />
            <Setter Property="BorderBrush" Value="#324257" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#F5F7FB" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#18283A" />
            <Setter Property="Foreground" Value="#F5F7FB" />
            <Setter Property="BorderBrush" Value="#34465C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#176CE7" />
            <Setter Property="BorderBrush" Value="#2E83F5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="28,24,28,20" BorderBrush="#243449" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="새 방송 추가" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="방송 주소를 입력하면 현재 녹화 목록에 바로 추가됩니다."
                           Margin="0,7,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22,28,20">
                <TextBlock Text="방송 주소" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="StreamUrlTextBox"
                         ToolTip="예: https://play.sooplive.com/채널ID/방송번호" />
                <TextBlock Text="SOOP 방송 페이지 주소를 그대로 붙여넣어 주세요."
                           Margin="0,7,0,20"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" />

                <TextBlock Text="화질" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox x:Name="QualityComboBox"
                          Width="190"
                          HorizontalAlignment="Left"
                          SelectedIndex="0"
                          Margin="0,0,0,10">
                    <ComboBoxItem Content="최고 화질" Tag="best" />
                    <ComboBoxItem Content="1080p 이하" Tag="1080" />
                    <ComboBoxItem Content="720p 이하" Tag="720" />
                    <ComboBoxItem Content="540p 이하" Tag="540" />
                    <ComboBoxItem Content="360p 이하" Tag="360" />
                </ComboBox>
                <TextBlock Text="모든 방송은 녹화 관리 화면에서 지정한 공통 저장 위치에 저장됩니다."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Margin="0,0,0,20" />

                <CheckBox x:Name="SubscriberRecordingCheckBox"
                          Content="구독자 전용 방송이에요"
                          Foreground="#D9E2EE"
                          FontSize="14"
                          Checked="SubscriberRecordingCheckBox_Changed"
                          Unchecked="SubscriberRecordingCheckBox_Changed" />
                <Border x:Name="CredentialsPanel"
                        Visibility="Collapsed"
                        Margin="0,13,0,0"
                        Padding="16"
                        Background="#101C2A"
                        BorderBrush="#293A4F"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SOOP ID" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="UsernameTextBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="비밀번호" Style="{StaticResource FieldLabelStyle}" />
                                <PasswordBox x:Name="PasswordBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="비밀번호는 저장되지 않으며 녹화를 시작한 뒤 즉시 지워집니다."
                                   Margin="0,9,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="28,18" BorderBrush="#243449" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Margin="0,0,10,0" IsCancel="True" />
                <Button Content="녹화 목록에 추가"
                        MinWidth="150"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
