<Window x:Class="StreamOrchestra.App.Views.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:StreamOrchestra.App.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SOOP 방송 녹화 | 녹화 관리"
        Width="1220"
        Height="868"
        MinWidth="1020"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="#0B1420"
        Foreground="#F5F7FB"
        FontFamily="Segoe UI, Malgun Gothic">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0B1420" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0E1927" />
        <SolidColorBrush x:Key="SubtlePanelBrush" Color="#111E2D" />
        <SolidColorBrush x:Key="DividerBrush" Color="#25364A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#91A0B3" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#176CE7" />
        <SolidColorBrush x:Key="LiveBrush" Color="#FF5B63" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#58D58B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F7FB" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#142235" />
            <Setter Property="Foreground" Value="#F5F7FB" />
            <Setter Property="BorderBrush" Value="#33465D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#3185F5" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#17202B" />
            <Setter Property="Foreground" Value="#FF6C73" />
            <Setter Property="BorderBrush" Value="#FF5B63" />
        </Style>
        <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#0D1723" />
            <Setter Property="Foreground" Value="#E7EDF6" />
            <Setter Property="BorderBrush" Value="#3A4C63" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
        </Style>
        <Style x:Key="RecordingListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#13283F" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#17365F" />
                    <Setter Property="BorderBrush" Value="#1F7BFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="#F2B84B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecordingSessionState.Recording}">
                    <Setter Property="Fill" Value="{StaticResource LiveBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecordingSessionState.Completed}">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecordingSessionState.Stopped}">
                    <Setter Property="Fill" Value="#7E8CA0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecordingSessionState.Failed}">
                    <Setter Property="Fill" Value="#FF9B54" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/soop-symbol-white.png" Width="32" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <TextBlock Text="SOOP 방송 녹화" FontSize="17" FontWeight="SemiBold" />
                    <Border Width="1" Height="20" Background="#425165" Margin="18,0" />
                    <TextBlock Text="녹화 관리" FontSize="17" FontWeight="SemiBold" Foreground="#C8D2DF" />
                </StackPanel>
                <Button Grid.Column="3" Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeWindowButton_Click" />
                <Button Grid.Column="4" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeWindowButton_Click" />
                <Button Grid.Column="5" Content="&#xE8BB;" Style="{StaticResource CaptionButtonStyle}" Click="CloseWindowButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,22,24,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="내 녹화" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock x:Name="RecordingCountTextBlock"
                                   Text="0"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="#2E84FF"
                                   Margin="9,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="RecordingSearchTextBox"
                             Margin="0,18,0,0"
                             ToolTip="방송 또는 주소 검색"
                             TextChanged="RecordingSearchTextBox_TextChanged" />
                    <TextBlock x:Name="SearchHintTextBlock"
                               Text="방송 또는 주소 검색"
                               IsHitTestVisible="False"
                               Foreground="#6F7F94"
                               FontSize="13"
                               Margin="13,-30,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <ListBox x:Name="RecordingListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource RecordingListItemStyle}"
                             SelectionChanged="RecordingListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RecordingSessionViewModel}">
                                <Grid Margin="20,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="124" Height="70" CornerRadius="7" Background="#183B91">
                                        <Grid>
                                            <Image Source="/Assets/soop-symbol-white.png" Width="44" Height="26" Stretch="Uniform" />
                                            <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="1" Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Style="{StaticResource StatusDotStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StateLabel}"
                                                       Foreground="#C8D2DF"
                                                       FontSize="13"
                                                       Margin="7,0,0,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElapsedText}"
                                                       Foreground="#A9B5C5"
                                                       FontSize="13" />
                                        </Grid>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding DetailTitle}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyQueuePanel" VerticalAlignment="Center" Margin="32">
                        <Border Width="70" Height="48" Background="#1748BE" CornerRadius="9">
                            <Image Source="/Assets/soop-symbol-white.png" Width="44" Height="26" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="아직 녹화 중인 방송이 없어요"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="방송을 추가하면 이곳에서 상태를 한눈에 볼 수 있어요."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13"
                                   Margin="22,8" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Margin="24,14,24,22"
                        Padding="0,17,0,0"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="저장 공간" FontWeight="SemiBold" />
                            <TextBlock x:Name="DiskSpaceTextBlock"
                                       Text="확인 중"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                        <ProgressBar x:Name="DiskSpaceProgressBar"
                                     Height="7"
                                     Minimum="0"
                                     Maximum="100"
                                     Margin="0,13,0,0"
                                     Foreground="#237AF4"
                                     Background="#26364B" />
                        <TextBlock x:Name="StorageStatusTextBlock"
                                   Margin="0,10,0,0"
                                   Foreground="#7E8CA0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="저장 위치 변경"
                                Height="34"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Click="ChangeOutputFolderButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

            <Grid Grid.Column="2" Background="{StaticResource PageBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="AddRecordingButton"
                        Content="방송 추가"
                        MinWidth="126"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,30,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddRecordingButton_Click" />
                <ContentControl x:Name="SelectedDetailHost"
                                Grid.Row="1">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type models:RecordingSessionViewModel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="28,28,30,30">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" MinWidth="300" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="1.08*" MinWidth="270" />
                                        </Grid.ColumnDefinitions>
                                        <Border Height="230" CornerRadius="11" Background="#183B91">
                                            <Grid>
                                                <Image Source="/Assets/soop-symbol-white.png" Width="96" Height="54" Stretch="Uniform" />
                                                <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" />
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="16"
                                                        Padding="10,5"
                                                        Background="#CC181D27"
                                                        CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="9" Height="9" Fill="{StaticResource LiveBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="라이브" Margin="7,0,0,0" Foreground="#FF7077" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DetailTitle}"
                                                       Margin="0,9,0,18"
                                                       FontSize="14"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16" />
                                            <Grid Margin="0,0,0,13">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="상태" Foreground="#98A7B9" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Ellipse Style="{StaticResource StatusDotStyle}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StateLabel}" Margin="8,0,0,0" />
                                                    <TextBlock Text="{Binding ElapsedText}" Margin="16,0,0,0" Foreground="#C8D2DF" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,13">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="화질" Foreground="#98A7B9" />
                                                <TextBlock Grid.Column="1" Text="{Binding QualityLabel}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,13">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="파일 크기" Foreground="#98A7B9" />
                                                <TextBlock Grid.Column="1" Text="{Binding FileSizeText}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="저장 위치" Foreground="#98A7B9" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding OutputFolder}"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D5DDE8" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0">
                                        <Button Content="{Binding PrimaryActionLabel}"
                                                Width="190"
                                                IsEnabled="{Binding CanUsePrimaryAction}"
                                                Click="RecordingPrimaryActionButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanStop}" Value="True">
                                                            <Setter Property="Background" Value="#17202B" />
                                                            <Setter Property="Foreground" Value="#FF6C73" />
                                                            <Setter Property="BorderBrush" Value="#FF5B63" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="폴더 열기"
                                                Width="150"
                                                Margin="12,0,0,0"
                                                Click="OpenSelectedFolderButton_Click" />
                                        <Button Content="방송 제거"
                                                Margin="12,0,0,0"
                                                Click="RemoveRecordingButton_Click" />
                                    </StackPanel>

                                    <Border Grid.Row="2"
                                            Height="1"
                                            Background="{StaticResource DividerBrush}"
                                            Margin="0,22,0,0" />

                                    <StackPanel Grid.Row="3" Margin="0,20,0,0">
                                        <TextBlock Text="최근 활동" FontSize="17" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Activities}" Margin="4,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:RecordingActivity}">
                                                    <Grid Margin="0,0,0,16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="1"
                                                                Height="34"
                                                                Background="#3E7FC9"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Top"
                                                                Margin="0,14,0,-24" />
                                                        <Ellipse Width="12"
                                                                 Height="12"
                                                                 Fill="#2B83FF"
                                                                 Stroke="#DDEBFF"
                                                                 StrokeThickness="1.5"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,3,0,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TimeText}"
                                                                   Foreground="#C5D0DD"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Message}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <StackPanel x:Name="EmptyDetailPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430">
                    <Border Width="90" Height="58" Background="#1748BE" CornerRadius="10" HorizontalAlignment="Center">
                        <Image Source="/Assets/soop-symbol-white.png" Width="56" Height="32" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="여러 방송을 한곳에서 녹화하세요"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0" />
                    <TextBlock Text="방송을 추가하면 각각 독립적으로 녹화되고, 진행 상태와 저장 결과를 이 화면에서 확인할 수 있어요."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"
                               LineHeight="22"
                               Margin="0,10,0,22" />
                    <Button Content="첫 방송 추가"
                            HorizontalAlignment="Center"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddRecordingButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" />
                    <TextBlock x:Name="SystemStatusTextBlock"
                               Text="녹화 도구 확인 중"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#9AA8B9" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="동시 최대 5개 녹화 지원"
                               VerticalAlignment="Center"
                               Foreground="#7F8EA1" />
                    <Button Content="녹화 도구 설정"
                            Height="34"
                            Margin="20,0,0,0"
                            Click="RecordingToolSettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
