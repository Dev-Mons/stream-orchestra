<Window x:Class="StreamOrchestra.App.Views.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOOP 방송 녹화"
        Width="620"
        Height="560"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#121820">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F6FA" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#223044" />
            <Setter Property="BorderBrush" Value="#3A4757" />
            <Setter Property="Foreground" Value="#F3F6FA" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Text="SOOP 방송 주소의 원본 스트림을 현재 시점부터 파일로 저장합니다. 녹화 권한이 있는 방송에만 사용하세요."
                   Foreground="#B9C2CC"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="방송 주소"
                   VerticalAlignment="Center" />
        <TextBox x:Name="StreamUrlTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Margin="0,0,0,10"
                 ToolTip="예: https://play.sooplive.com/채널ID/방송번호" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="저장 폴더"
                   VerticalAlignment="Center" />
        <TextBox x:Name="OutputFolderTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="0,0,8,10" />
        <Button x:Name="BrowseFolderButton"
                Grid.Row="2"
                Grid.Column="2"
                Margin="0,0,0,10"
                Content="찾아보기"
                Click="BrowseFolderButton_Click" />

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="화질"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="QualityComboBox"
                  Grid.Row="3"
                  Grid.Column="1"
                  Width="150"
                  HorizontalAlignment="Left"
                  SelectedIndex="0"
                  Margin="0,0,0,12">
            <ComboBoxItem Content="최고 화질" Tag="best" />
            <ComboBoxItem Content="1080p 이하" Tag="1080" />
            <ComboBoxItem Content="720p 이하" Tag="720" />
            <ComboBoxItem Content="540p 이하" Tag="540" />
            <ComboBoxItem Content="360p 이하" Tag="360" />
        </ComboBox>

        <Border Grid.Row="4"
                Grid.ColumnSpan="3"
                Padding="12,10"
                Margin="0,0,0,12"
                Background="#0F141B"
                BorderBrush="#2D3642"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ToolStatusTextBlock"
                               Text="녹화 도구 확인 중..."
                               FontWeight="SemiBold" />
                    <ProgressBar x:Name="ToolInstallProgressBar"
                                 Height="4"
                                 Margin="0,7,12,0"
                                 Minimum="0"
                                 Maximum="1"
                                 Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="InstallToolButton"
                        Grid.Column="1"
                        Content="녹화 도구 설치"
                        Click="InstallToolButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="5"
              Grid.ColumnSpan="3"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RecordingStatusTextBlock"
                       Text="대기 중"
                       Foreground="#B9C2CC"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ElapsedTextBlock"
                       Grid.Column="1"
                       Text="00:00:00"
                       Foreground="#B9C2CC"
                       VerticalAlignment="Center" />
        </Grid>

        <TextBox x:Name="LogTextBox"
                 Grid.Row="6"
                 Grid.ColumnSpan="3"
                 Height="Auto"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="#080B0F"
                 Foreground="#AEB8C3"
                 FontFamily="Consolas"
                 FontSize="12" />

        <StackPanel Grid.Row="7"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="폴더 열기"
                    Margin="0,0,8,0"
                    Click="OpenFolderButton_Click" />
            <Button x:Name="StopButton"
                    Content="중지"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="StopButton_Click" />
            <Button x:Name="StartButton"
                    Content="● 녹화 시작"
                    Background="#A32626"
                    BorderBrush="#C94A4A"
                    FontWeight="SemiBold"
                    Click="StartButton_Click" />
        </StackPanel>
    </Grid>
</Window>
