<Window x:Class="StreamOrchestra.App.Views.BrowserDataResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="브라우저 데이터 초기화"
        Height="390"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#121820">
    <Border Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="초기화할 브라우저 그룹"
                       Foreground="#F3F6FA"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <ComboBox x:Name="ProfileGroupComboBox"
                      Grid.Row="1"
                      Height="34"
                      DisplayMemberPath="DisplayName"
                      VerticalContentAlignment="Center"
                      Margin="0,0,0,16" />

            <TextBlock Grid.Row="2"
                       Text="삭제할 데이터"
                       Foreground="#F3F6FA"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <StackPanel Grid.Row="3">
                <CheckBox x:Name="SiteDataCheckBox"
                          Content="쿠키 및 사이트 데이터"
                          IsChecked="True"
                          Foreground="#F3F6FA"
                          Margin="0,0,0,4" />
                <TextBlock Text="로그인 정보, Local Storage, IndexedDB, Service Worker 등을 삭제합니다."
                           Foreground="#8F9AA7"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="24,0,0,12" />

                <CheckBox x:Name="CacheCheckBox"
                          Content="캐시된 이미지 및 파일"
                          IsChecked="True"
                          Foreground="#F3F6FA"
                          Margin="0,0,0,4" />
                <TextBlock Text="선택한 그룹의 디스크 캐시만 삭제합니다."
                           Foreground="#8F9AA7"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="24,0,0,12" />
            </StackPanel>

            <Border Grid.Row="4"
                    Background="#1B2531"
                    BorderBrush="#2D3642"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,2,0,0">
                <TextBlock Text="쿠키 및 사이트 데이터를 선택하면 해당 그룹에서 로그아웃될 수 있습니다. Stream Orchestra의 레이아웃, 프리셋, 단축키 설정은 삭제하지 않습니다."
                           Foreground="#F6C177"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="5"
                       Foreground="#FCA5A5"
                       FontSize="11"
                       VerticalAlignment="Top"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="취소"
                        MinWidth="80"
                        Height="30"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="CancelButton_Click" />
                <Button Content="선택 항목 초기화"
                        MinWidth="128"
                        Height="30"
                        Background="#7F1D1D"
                        BorderBrush="#B43A3A"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        Click="ClearButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
